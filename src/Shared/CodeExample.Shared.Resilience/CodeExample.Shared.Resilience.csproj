<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The resilience pipeline shared by the outbound HTTP clients. Kept apart from
    Shared.Web so a published client package can take the pipeline without taking
    Swashbuckle, JwtBearer and the request pipeline with it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
