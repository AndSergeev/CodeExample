<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MediatR pipeline every service runs: validation, logging and exception translation.
    Lives apart from the web layer because a console host needs it too and must not drag in
    Swashbuckle or an HTTP pipeline to get it.
  -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeExample.Shared.Abstractions\CodeExample.Shared.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
