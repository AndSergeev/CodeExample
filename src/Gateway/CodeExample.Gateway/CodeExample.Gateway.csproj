<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API gateway built on YARP. It owns routing, the reading of the caller token and
    the unified error contract, while YARP only provides the reverse-proxy
    transport (streaming, header forwarding, backend load balancing).
  -->
  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\CodeExample.Shared.Web\CodeExample.Shared.Web.csproj" />
  </ItemGroup>

</Project>
