<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The currency service database migrator. Besides the service tables it creates the Quartz
    store schema, so that DDL travels embedded in the executable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeExample.CurrencyService.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeExample.CurrencyService.Infrastructure\CodeExample.CurrencyService.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\CodeExample.Shared.Migrations\CodeExample.Shared.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied next to the executable: DbUp reads them from the assembly,
         so a deployment cannot end up with scripts missing while the binary claims to be complete.
         Quartz ships no DDL in its packages, so its schema travels here too. -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK copies appsettings automatically; a console project does not,
         so the migrator would find no configuration next to its executable. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
