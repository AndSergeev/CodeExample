{
  "ConnectionStrings": {
    "CurrencyDatabase": "Host=localhost;Port=5432;Database=codeexample_currency;Username=codeexample;Password="
  },
  "ServiceOptions": {
    "Name": "currency"
  },
  "SwaggerOptions": {
    "Title": "CodeExample Currency Service",
    "Description": "Currency reference owned by this service: the CBR rates and the synchronisation state.",
    "Version": "v1",
    "Scheme": "ApiKey"
  },
  "CurrencySyncOptions": {
    "Cron": "0 30 11 * * ?",
    "TimeZoneId": "Russian Standard Time",
    "SourceUrl": "http://www.cbr.ru/scripts/XML_daily.asp",
    "TimeoutSeconds": 30,
    "TotalTimeoutSeconds": 180
  },
  "CurrencySyncStartupOptions": {
    "RunOnStartup": true
  },
  "InternalApiKeyOptions": {
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Quartz": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
